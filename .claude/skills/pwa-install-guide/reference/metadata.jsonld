      "schema:inLanguage": "ko",
      "schema:version": "1.0.0",
      "dcterms:created": "2026-10-16",
      "schema:author": { "schema:name": "miyeongssam (최미영) + Claude Code" },
      "schema:isBasedOn": [
        { "id": "https://github.com/miyeongssam/choisci-homepage", "schema:description": "client/src/components/InstallAppButton.tsx (학원 홈페이지 설치 배너)" },
        { "id": "https://github.com/miyeongssam/kim-minji", "schema:description": "인계장 1.2.0~1.2.2 설치 안내와 실제 안드로이드 문제 해결 기록 (ADR-017~020, 026, 027)" }
      ],
      "schema:tool": ["Playwright(테스트)", "chrome://webapks(진단)"],
      "schema:step": [
        { "type": "schema:HowToStep", "schema:position": 1, "schema:name": "manifest 점검: 고정 id, 아이콘 any+maskable, apple-touch-icon, description+screenshots, 범용 문구" },
        { "type": "schema:HowToStep", "schema:position": 2, "schema:name": "상태 판정: app / desktop / inapp / other / chrome / safari" },
        { "type": "schema:HowToStep", "schema:position": 3, "schema:name": "설치 배너와 안내 창: 크롬 설치 창, 아이폰 2단계, 크롬·사파리로 열기, 주소 복사" },
        { "type": "schema:HowToStep", "schema:position": 4, "schema:name": "기기 안 저장 앱은 설치 먼저 화면" },
        { "type": "schema:HowToStep", "schema:position": 5, "schema:name": "8종 브라우저 자동 테스트" },
        { "type": "schema:HowToStep", "schema:position": 6, "schema:name": "링크 공유 안내문: 복사해서 크롬(아이폰은 사파리) 주소창에" },
        { "type": "schema:HowToStep", "schema:position": 7, "schema:name": "결정·작업 기록(ADR, prov:Activity)" }
      ],
      "pig:browserStates": { "id": "pig:states" },
      "pig:troubleshooting": { "id": "pig:stale-install" }
    },
    {
      "id": "pig:states",
      "type": "skos:ConceptScheme",
      "skos:prefLabel": "설치 상태",
      "skos:hasTopConcept": [
        { "id": "pig:app", "skos:prefLabel": "설치된 앱으로 열림", "skos:definition": "display-mode standalone 또는 navigator.standalone. 배너 없음" },
        { "id": "pig:desktop", "skos:prefLabel": "컴퓨터", "skos:definition": "배너 없음" },
        { "id": "pig:inapp", "skos:prefLabel": "앱 안 화면", "skos:definition": "카톡·슬랙·네이버·인스타·페이스북·라인·밴드·다음·텔레그램·에브리타임, 안드로이드 wv, Safari 토큰 없는 아이폰. 크롬/사파리로 넘기기" },
        { "id": "pig:other", "skos:prefLabel": "다른 브라우저", "skos:definition": "삼성 인터넷·엣지·오페라·웨일·파이어폭스·아이폰 크롬 등. 크롬/사파리로 넘기기" },
        { "id": "pig:chrome", "skos:prefLabel": "안드로이드 크롬", "skos:definition": "beforeinstallprompt 있으면 설치 창, 없으면 ⋮ → 앱 설치 안내" },
        { "id": "pig:safari", "skos:prefLabel": "아이폰 사파리", "skos:definition": "공유 → 홈 화면에 추가 안내" }
      ]
    },
    {
      "id": "pig:stale-install",
      "type": "schema:HowTo",
      "schema:name": "안드로이드: 이미 설치됨인데 앱이 없을 때",
      "schema:step": [
        { "type": "schema:HowToStep", "schema:position": 1, "schema:name": "chrome://webapks 에 앱이 있는지 확인" },
        { "type": "schema:HowToStep", "schema:position": 2, "schema:name": "없으면 manifest id를 새 고정값으로 한 번만 바꾸고 배포" },
        { "type": "schema:HowToStep", "schema:position": 3, "schema:name": "크롬 바로가기 삭제 → 크롬 주소창에 주소 → 배너로 설치 → 다시 확인" }
      ],
      "pig:doNot": "같은 도메인의 사이트 데이터 지우기 안내 (다른 앱 기록까지 지워짐)"
    },
